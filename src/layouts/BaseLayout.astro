---
// Shared page shell: <head>, global styles, waving background and the page content (<slot />).
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollHint from "../components/ScrollHint.astro";
import PageLoader from "../components/PageLoader.astro";
import Background from "../components/Background.astro";

const {
  title,
  description = "Portfolio of Quinten van der Vlies, a Dutch creative developer working where design and development meet.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- is:inline = placed in the HTML as-is, runs before the page is painted (prevents a dark/light flash) -->
    <script is:inline>
      // "js" class: reveal animations may hide content only when JavaScript runs
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {}

      // Page loader: only on the first visit in this browser session, never with reduced motion
      try {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduce && !sessionStorage.getItem("loaderSeen")) {
          document.documentElement.classList.add("is-loading");
          sessionStorage.setItem("loaderSeen", "1");
        }
      } catch {}
    </script>
  </head>
  <body>
    <Background />
    <PageLoader />
    <Navbar />
    <slot />
    <Footer />
    <ScrollHint />

    <!-- Bundled by Astro, runs after the page has loaded -->
    <script>
      import { initReveal } from "../scripts/reveal.js";

      // Start the reveal animations right away, or after the page loader is gone
      if (document.documentElement.classList.contains("is-loading")) {
        document.addEventListener("loader:done", initReveal, { once: true });
      } else {
        initReveal();
      }
    </script>
  </body>
</html>
