---
// Three small bars showing a skill level (1–3). Decorative: the level is also given as text nearby.
// Usage: <LevelMeter level={2} />
const { level } = Astro.props;
---

<span class="flex items-end gap-0.5" aria-hidden="true">
  {[1, 2, 3].map((bar) => (
    <span
      class:list={["w-1 rounded-full", bar <= level ? "bg-bone" : "bg-steel"]}
      style={`height: ${4 + bar * 3}px`}
    ></span>
  ))}
</span>
