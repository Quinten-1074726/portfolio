---
// One project as a clickable row: title left, meta + arrow right.
// The summary slides open on hover / keyboard focus (always visible on touch screens).
// Usage: <ProjectRow title="SonarPop" summary="..." meta={["React", "Chart.js"]} href="/projects/sonarpop" />
const { title, summary, meta = [], href } = Astro.props;

// Shared "open" state: hover, keyboard focus, and always on devices without hover (touch)
const open = "group-hover:grid-rows-[1fr] group-focus-visible:grid-rows-[1fr] [@media(hover:none)]:grid-rows-[1fr]";
const openText = "group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100";
---

<a href={href} class="group block border-b border-line py-7 sm:py-9">
  <span class="flex items-center justify-between gap-6">
    <!-- Big title that slides a little to the right on hover -->
    <span
      class="font-display text-[clamp(2rem,4.2vw,4rem)] font-light leading-none tracking-[-0.035em] transition duration-500 ease-out group-hover:translate-x-3 group-hover:text-signal"
    >
      {title}
    </span>

    <span class="flex shrink-0 items-center gap-8">
      <span class="label hidden text-ash sm:inline">{meta.join(" · ")}</span>
      <span
        aria-hidden="true"
        class="text-2xl text-ash transition duration-500 ease-out group-hover:translate-x-2 group-hover:text-signal sm:text-4xl"
      >
        →
      </span>
    </span>
  </span>

  <!-- Height animates from 0 to auto via grid rows (0fr → 1fr) -->
  <span class:list={["grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out", open]}>
    <span class="overflow-hidden">
      <span class:list={["block max-w-[60ch] pt-4 text-lg leading-relaxed text-ash opacity-0 transition-opacity duration-500", openText]}>
        {summary}
      </span>
    </span>
  </span>
</a>
