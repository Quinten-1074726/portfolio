---
// Skills grouped per category, shown as a small terminal-style tree.
// Draft based on CLAUDE.md and the project stacks. TODO: check, reorder and complete the lists.
const groups = [
  {
    name: "Frontend",
    skills: ["React", "React Router", "Tailwind CSS", "Framer Motion", "Alpine.js", "Chart.js", "Vite"],
  },
  {
    name: "Mobile",
    skills: ["React Native", "Expo", "NativeWind"],
  },
  {
    name: "Backend",
    skills: ["Node.js", "Express", "MongoDB", "Laravel", "REST APIs", "JWT auth"],
  },
  {
    name: "AI",
    skills: ["Azure OpenAI", "AI agents & tools", "Document retrieval"],
  },
  {
    name: "Design & tools",
    skills: ["TODO: e.g. design tools", "TODO: e.g. Git / GitHub"],
  },
];
---

<div class="grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 lg:grid-cols-5" data-reveal-stagger>
  {groups.map((group) => (
    <div>
      <h3 class="label text-bone">{group.name}</h3>
      <ul class="mt-4 space-y-2 font-mono text-sm">
        {group.skills.map((skill, index) => (
          <li class="flex gap-2 text-ash">
            <span aria-hidden="true" class="text-smoke">
              {index === group.skills.length - 1 ? "└─" : "├─"}
            </span>
            <span>{skill}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
