---
// Floating glass navbar. The links are pure HTML/CSS; only the theme toggle uses a small script.
// Astro.url.pathname is the current URL path, used to mark the active page.
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "Timeline", href: "/timeline" },
  { label: "About", href: "/about" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// Home is only active on "/", other links also on their sub pages (e.g. /projects/sonarpop)
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav aria-label="Main" class="glass flex items-center rounded-full p-1.5">
    <ul class="flex items-center gap-0.5 sm:gap-1">
      {links.map((link) => {
        const active = isActive(link.href);
        return (
          <li>
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "relative block rounded-full px-3 py-2 text-sm transition-colors duration-300 sm:px-4",
                active ? "bg-glass-hover text-bone" : "text-ash hover:bg-glass hover:text-bone",
              ]}
            >
              {link.label}
              {active && (
                <span
                  aria-hidden="true"
                  class="absolute bottom-1 left-1/2 size-1 -translate-x-1/2 rounded-full bg-signal"
                />
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <span aria-hidden="true" class="mx-1 h-5 w-px bg-line sm:mx-1.5"></span>
    <ThemeToggle />
  </nav>
</header>
