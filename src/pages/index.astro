---
// Home page: name, three projects, short about. Footer comes from BaseLayout.
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import GlassButton from "../components/GlassButton.astro";
import Skills from "../components/Skills.astro";
import { getProjects } from "../data/projects.js";

// Featured projects from the content collection (featured: true in the .md file), max 3
const projects = (await getProjects())
  .filter((project) => project.data.featured)
  .slice(0, 3)
  .map((project) => ({
    title: project.data.title,
    summary: project.data.summary,
    meta: project.data.stack.slice(0, 2), // first two tools of the stack
    href: `/projects/${project.id}`,
  }));
---

<BaseLayout title="Quinten van der Vlies · Creative developer" description="Portfolio of Quinten van der Vlies, a Dutch creative developer working where design and development meet.">
  <main>
    <!-- Name: "Quinten" top left with a small vertical "van der", "Vlies" bottom right.
         Words slide up on page load (line-mask + line-up in global.css). -->
    <!-- flex-col + mt-auto on the bottom bar: the bar sits at the bottom of the first screen -->
    <section class="wrap flex min-h-[90svh] flex-col pt-32 pb-10 sm:pt-40">
      <!-- w-fit + mx-auto: the block is exactly as wide as the name and centred on the page.
           Remove "mx-auto w-fit" to align it to the left again. -->
      <div class="relative mx-auto w-fit">
        <h1 class="heading-display uppercase">
          <span class="flex items-start gap-[0.08em]">
            <span class="line-mask"><span class="line-up">Quinten</span></span>
            <span class="name-vertical" data-reveal style="--reveal-delay: 450ms">van der</span>
          </span>
          <!-- Indent in em (relative to the font size), so it scales with the name -->
          <span class="flex pl-[3.2em]">
            <span class="line-mask"><span class="line-up" style="--line-delay: 140ms">Vlies</span></span>
          </span>
        </h1>

        <!-- Role + intro: below the name on mobile, in the empty space left of "Vlies" on larger screens -->
        <div class="mt-10 xl:absolute xl:bottom-[0.6vw] xl:left-0 xl:mt-0 xl:w-[28vw] xl:max-w-[30rem]">
          <!-- Role in the mono font: a technical "title card" contrast with the big name -->
          <p class="font-mono text-base tracking-[0.25em] text-bone uppercase sm:text-xl" data-reveal style="--reveal-delay: 600ms">
            Creative developer
          </p>
          <p class="mt-4 max-w-[40ch] text-lg leading-relaxed text-ash" data-reveal style="--reveal-delay: 720ms">
            Using creativity to bring design and code together in websites and apps that look and feel right.
          </p>
        </div>
      </div>

      <!-- Bottom bar: small facts, bottom right of the first screen -->
      <div class="mt-auto space-y-2 pt-16 sm:text-right" data-reveal style="--reveal-delay: 900ms">
        <p class="label text-ash">Based in the Netherlands</p>
        <p class="label text-ash">Design · Code</p>
      </div>
    </section>

    <!-- Projects (scroll-mt: leaves room for the navbar when jumping here) -->
    <section id="projects" class="wrap scroll-mt-28 pt-24 sm:pt-32">
      <h2 class="heading-xl" data-reveal>Projects</h2>

      <div class="mt-8 sm:mt-10" data-reveal-stagger>
        {projects.map((project) => (
          <ProjectRow
            title={project.title}
            summary={project.summary}
            meta={project.meta}
            href={project.href}
          />
        ))}
      </div>

      <div class="mt-12" data-reveal>
        <GlassButton href="/projects">Discover more →</GlassButton>
      </div>
    </section>

    <!-- About -->
    <section class="wrap pt-40 sm:pt-56">
      <div class="grid gap-10 md:grid-cols-2 md:gap-16">
        <h2 class="heading-xl" data-reveal>About</h2>

        <div data-reveal>
          <p class="text-2xl leading-snug text-bone sm:text-3xl">Design-minded. Code-driven.</p>
          <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-ash">
            I'm Quinten, a creative developer with a background in both design and development. I care about the
            details that make something feel right, and I'm always curious about what's next.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <GlassButton href="/about">More about me</GlassButton>
            <GlassButton href="/timeline">Timeline</GlassButton>
          </div>
        </div>
      </div>

      <div class="mt-16 sm:mt-20">
        <Skills />
      </div>
    </section>
  </main>
</BaseLayout>
