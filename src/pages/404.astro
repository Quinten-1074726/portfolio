---
// Shown when a page does not exist. Astro builds this as 404.html; Vercel serves it automatically.
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/GlassButton.astro";
---

<BaseLayout title="Page not found · Quinten van der Vlies" description="This page does not exist.">
  <main class="wrap flex min-h-[80svh] flex-col justify-center pt-32">
    <p class="label text-ash" data-reveal>Error 404</p>
    <h1 class="heading-display mt-6 uppercase">
      <span class="line-mask"><span class="line-up">Lost in space</span></span>
    </h1>
    <p class="mt-10 max-w-[44ch] text-lg leading-relaxed text-ash" data-reveal style="--reveal-delay: 300ms">
      This page doesn't exist (anymore). Let's get you back on track.
    </p>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 400ms">
      <GlassButton href="/">Back home</GlassButton>
      <GlassButton href="/projects">View projects</GlassButton>
    </div>
  </main>
</BaseLayout>
