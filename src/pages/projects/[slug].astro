---
// Project detail page. [slug] in the file name = one page per project.
// getStaticPaths() tells Astro which pages to build: one for every Markdown file in src/content/projects.
// Order: header (summary + buttons | info + stack/languages) → About + preview → collage → design carousel → next project.
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import { siGithub, siFigma } from "simple-icons";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlassButton from "../../components/GlassButton.astro";
import Chip from "../../components/Chip.astro";
import Collage from "../../components/Collage.astro";
import DesignCarousel from "../../components/DesignCarousel.astro";
import MediaPlaceholder from "../../components/MediaPlaceholder.astro";
import { getProjects, contextText } from "../../data/projects.js";
import { getRepoInfo, languageColor } from "../../data/github.js";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id }, // file name without .md, e.g. "sonarpop"
    props: { project, next: projects[(index + 1) % projects.length] }, // next project wraps around to the first
  }));
}

const { project, next } = Astro.props;
const { title, summary, year, role, type, context, team, stack, cover, gallery, video, designs, figma, repo, live } = project.data;
const { Content } = await render(project); // the Markdown body ("About the project") as a component
const github = await getRepoInfo(repo); // languages from GitHub (null if unavailable)
const slug = project.id;

// Info rows (only the ones that are filled in)
const info = [
  { label: "Year", value: year },
  { label: "Type", value: type }, // what it is, e.g. "Web app"
  { label: "Context", value: contextText({ context, team }) }, // e.g. "School project · Team"
  { label: "Role", value: role },
].filter((row) => row.value);

const languages = github?.languages ?? [];
const hasPreview = video || cover; // something to show next to "About the project"

// Small WebP version of the cover, shown as the video poster while the video loads
const poster = cover ? (await getImage({ src: cover, width: 800, format: "webp" })).src : undefined;
---

<BaseLayout title={`${title} · Quinten van der Vlies`} description={summary}>
  <main class="wrap pt-32 sm:pt-40">
    <a href="/projects" class="label inline-flex items-center gap-2 text-ash transition-colors hover:text-signal" data-reveal>
      ← All projects
    </a>

    <h1 class="heading-display mt-8 uppercase">
      <span class="line-mask"><span class="line-up">{title}</span></span>
    </h1>

    <!-- 1. Header: summary + buttons left | info, then stack and languages side by side, right -->
    <section class="mt-14 grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20" data-reveal style="--reveal-delay: 300ms">
      <div>
        <p class="max-w-[46ch] text-2xl leading-snug text-bone sm:text-3xl">{summary}</p>

        {(repo || live) && (
          <div class="mt-10 flex flex-wrap gap-3">
            {repo && (
              <GlassButton href={`https://github.com/${repo}`} target="_blank" aria-label="View the code on GitHub (opens in a new tab)">
                <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-current"><path d={siGithub.path} /></svg>
                GitHub
              </GlassButton>
            )}
            {live && <GlassButton href={live} target="_blank">View live ↗</GlassButton>}
          </div>
        )}
      </div>

      <div class="self-start">
        {info.length > 0 && (
          <dl class="border-t border-line">
            {info.map((row) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-line py-3.5">
                <dt class="label text-ash">{row.label}</dt>
                <dd class:list={["text-right", row.label === "Year" && "font-mono text-dust"]}>{row.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <!-- Stack and languages next to each other -->
        {(stack.length > 0 || languages.length > 0) && (
          <div class="mt-8 grid grid-cols-2 gap-6">
            <div>
              <p class="label text-ash">Stack</p>
              <div class="mt-3 flex flex-wrap gap-1.5">{stack.map((tool) => <Chip>{tool}</Chip>)}</div>
            </div>
            {languages.length > 0 && (
              <div>
                <p class="label text-ash">Languages</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {languages.map((language) => (
                    <Chip>
                      <span
                        aria-hidden="true"
                        class="mr-1.5 inline-block size-2 rounded-full align-middle"
                        style={`background-color: ${languageColor(language.name)}`}
                      ></span>
                      {language.name} <span class="text-ash">{language.percent}%</span>
                    </Chip>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- 2. About the project (left) + preview: video, otherwise the cover (right).
         The video keeps its own shape (landscape or portrait phone recording), max 75% of the screen height. -->
    <section
      class:list={[
        "mt-24 grid items-start gap-12 sm:mt-32",
        (hasPreview || import.meta.env.DEV) && "lg:grid-cols-[1fr_1.3fr] lg:gap-20",
      ]}
    >
      <article class="case max-w-[60ch]" data-reveal>
        <Content />
      </article>

      <div class="relative" data-reveal style="--reveal-delay: 150ms">
        <!-- Soft blue + warm glow behind the preview (same as behind the photo on About) -->
        {hasPreview && (
          <>
            <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 size-64 rounded-full bg-signal/20 blur-3xl"></div>
            <div aria-hidden="true" class="pointer-events-none absolute -right-8 -bottom-10 size-56 rounded-full bg-dust/15 blur-3xl"></div>
          </>
        )}
        {video ? (
          <video
            src={video}
            poster={poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            data-preview-video
            class="relative mx-auto block max-h-[75svh] w-auto max-w-full rounded-2xl border border-line bg-night"
          ></video>
        ) : cover ? (
          <Image
            src={cover}
            alt={`${title} preview`}
            widths={[800, 1400]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            loading="eager"
            class="relative w-full rounded-2xl border border-line"
          />
        ) : (
          <MediaPlaceholder label="Preview (video or cover)" hint={`video: /projects/${slug}/preview.mp4  or  cover: ./${slug}/cover.jpg`} />
        )}
      </div>
    </section>

    <!-- 3. Collage of screenshots -->
    {(gallery.length > 0 || import.meta.env.DEV) && (
      <section class="mt-24 sm:mt-32">
        {gallery.length > 0 ? (
          <Collage images={gallery} title={title} />
        ) : (
          <MediaPlaceholder label="Screenshot collage" hint={`gallery: [./${slug}/1.jpg, ./${slug}/2.jpg, ...]  (next to the .md file)`} />
        )}
      </section>
    )}

    <!-- 4. Design carousel: only for projects that have design work (wireframes, styleguide, Figma).
         Not every project has this, so there is no placeholder: add `designs` or `figma` to show it. -->
    {(designs.length > 0 || figma) && (
      <section class="mt-24 sm:mt-32">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <h2 class="heading-lg">Design</h2>
          {figma && (
            <GlassButton href={figma} target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-current"><path d={siFigma.path} /></svg>
              Open in Figma
            </GlassButton>
          )}
        </div>
        <div class="mt-10" data-reveal>
          {designs.length > 0 && <DesignCarousel images={designs} title={title} />}
        </div>
      </section>
    )}

    <!-- 5. Next project -->
    <a href={`/projects/${next.id}`} class="group mt-32 block border-t border-line pt-10 sm:mt-44" data-reveal>
      <span class="label text-ash">Next project</span>
      <span class="mt-4 flex items-center justify-between gap-6">
        <span class="heading-xl transition duration-500 ease-out group-hover:translate-x-3 group-hover:text-signal">
          {next.data.title}
        </span>
        <span aria-hidden="true" class="text-4xl text-ash transition duration-500 group-hover:translate-x-2 group-hover:text-signal">
          →
        </span>
      </span>
    </a>
  </main>
</BaseLayout>

<script>
  // Reduced motion: don't autoplay preview videos, show the controls instead
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("[data-preview-video]").forEach((video) => {
      video.pause();
      video.controls = true;
    });
  }
</script>
